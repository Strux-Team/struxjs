# Application Setup
APP_NAME="StruxJS Framework"
APP_ENV=development
APP_KEY=struxjs_secret_app_key_change_in_production
APP_DEBUG=true
APP_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=en

# Logging Configuration (stack | console | daily | single)
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration (mysql | postgres | sqlite | mongodb)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=struxjs
DB_FILENAME=./database/database.sqlite
DB_LOG_QUERIES=false

# Session Configuration (file | database | memory | redis)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=struxjs_session
SESSION_TABLE=sessions
SESSION_DOMAIN=
SESSION_SECURE=false

# Cache Configuration (memory | file | database | redis)
CACHE_DRIVER=memory
CACHE_PREFIX=strux:cache:

# Queue Configuration (sync | redis | database | file)
QUEUE_CONNECTION=sync

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_PREFIX=strux_

# JWT Authentication
JWT_SECRET=struxjs_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Mail Configuration (smtp | mailgun | log | array)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=StruxJS

# Mailgun Configuration (optional)
MAILGUN_SECRET=
MAILGUN_DOMAIN=
MAILGUN_ENDPOINT=api.mailgun.net

# Vite Asset Compilation Pipeline
VITE_DEV=true
VITE_PORT=5173

# CORS Configuration
CORS_ENABLED=true
