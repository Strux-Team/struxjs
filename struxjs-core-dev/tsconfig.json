{
  "compilerOptions": {
    /* Environment and Versions */
    "target": "ES2022" /* Compile into modern JS code suitable for Node.js 18+ */,
    "module": "NodeNext" /* Use modern Node.js ES Modules (import/export) standard */,
    "moduleResolution": "NodeNext" /* Use the latest module resolution algorithm for Node.js */,
    /* Required Configuration for IoC Container & Decorators */
    "experimentalDecorators": true /* Enable experimental support for legacy decorators (@Inject, @Injectable) */,
    "emitDecoratorMetadata": true /* Automatically emit type metadata required for IoC reflection */,
    /* Output and Input Directories */
    "outDir": "./dist" /* Redirect output structure to the dist directory */,
    "rootDir": "./src" /* Specify the root folder of input TypeScript files */,
    "declaration": true /* Generate corresponding '.d.ts' file for framework types */,
    "sourceMap": true /* Create a source map file for easier debugging directly in TS files */,
    /* Strict Type-Checking Options */
    "strict": true /* Enable all strict type-checking options */,
    "noImplicitAny": true /* Raise error on expressions and declarations with an implied 'any' type */,
    "strictNullChecks": true /* When type checking, take 'null' and 'undefined' into account */,
    /* Ecosystem and Interoperability Compatibility */
    "esModuleInterop": true /* Emit additional JavaScript to ease support for importing CommonJS modules */,
    "forceConsistentCasingInFileNames": true /* Ensure that casing is correct in imports */,
    "skipLibCheck": true /* Skip type checking of declaration files to speed up the build process */
  },
  "include": [
    "src/**/*"
  ] /* Only compile files inside the src directory */,
  "exclude": [
    "node_modules",
    "dist"
  ] /* Exclude node_modules and dist folders from compilation */
}